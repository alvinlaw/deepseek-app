{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek",
  "version": "0.1.0",
  "identifier": "deepseek-app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "https://chat.deepseek.com",
    "beforeDevCommand": "echo 'using web url'",
    "beforeBuildCommand": "echo 'using web url'"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 300,
        "resizable": true,
        "fullscreen": false,
        "url": "https://chat.deepseek.com"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "msi", "dmg", "app"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "DeepSeek web wrapper desktop app",
    "longDescription": "A lightweight cross-platform desktop wrapper for the official DeepSeek web app."
  }
}
